# Scenario 04 — cyber-range deployment settings.
# Copy to .env and edit. deploy.sh, verify.sh and reset.sh all read this file.

# ---- target host -------------------------------------------------------------
# The IP the range reaches this VM on. The product hard-codes 192.168.0.154 in
# localhost.ext and manager/manager.yaml; deploy.sh rewrites both with this.
RANGE_HOST_IP=10.10.20.40

# The product's compose file hard-codes a developer's motherboard model as the
# container hostname. Anything stable is fine.
RANGE_HOSTNAME=seuxdr-range

# ---- product reference -------------------------------------------------------
# 00a95ad                     -> baseline: unauthenticated API, 2 of 30 objectives
# cra/remediation-sprint-1    -> remediated: authenticated, 21 of 30 objectives
RANGE_PRODUCT_REF=00a95ad
RANGE_PRODUCT_REPO=git@github.com:CyberGuardEU/t4.4_siem_ai_remediation.git
RANGE_INSTALL_DIR=/srv/seuxdr

# ---- resources ---------------------------------------------------------------
# off  -> strip the hard NVIDIA device reservation so Ollama starts CPU-only.
#         AI analysis will usually exceed the manager's hard-coded 60s cap.
# on   -> keep it. Requires an NVIDIA GPU and the container toolkit.
RANGE_GPU=off

# Model pulled by the Ollama container. phi4:14b is the product default and
# needs ~9GB and 32GB RAM; phi3:mini is far quicker on CPU-only range hosts.
RANGE_MODEL=phi4:14b

# ---- startup mode ------------------------------------------------------------
# TEST generates a local CA and self-signed certs, which is correct for a range.
# PROD expects certificates you supply. Never use PROD here.
RANGE_STARTUP_MODE=TEST
